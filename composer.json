{
	"name" : "dmk/mkcleaner",
	"description" : "Cleans files by removing any metadata with the help of mat2, exiftool and qpdf according to BSI guidelines.",
	"type" : "typo3-cms-extension",
	"keywords" : [
		"TYPO3 CMS",
		"mat2",
		"exiftool",
		"qpdf",
		"BSI",
		"metadata",
		"cleaner",
		"security"
	],
	"homepage" : "http://www.dmk-ebusiness.de/",
	"license": "GPL-2.0-or-later",
	"authors" : [{
			"name" : "Hannes Bochmann",
			"email" : "dev@dmk-ebusiness.com",
			"role" : "Developer"
		}
	],
	"support": {
		"email": "dev@dmk-ebusiness.de",
		"source": "https://github.com/DMKEBUSINESSGMBH/typo3-mkcleaner",
		"issues": "https://github.com/DMKEBUSINESSGMBH/typo3-mkcleaner"
	},
    "repositories" : [
        {
            "type" : "vcs",
            "url" : "https://github.com/sat-hub/phpcpd.git"
        }
    ],
	"require": {
        "typo3/cms-core": "^12.4 || ^13.4"
	},
	"require-dev": {
        "captainhook/captainhook": "^5.10",
		"php-parallel-lint/php-parallel-lint": "^1.3",
		"friendsofphp/php-cs-fixer": "^3.4",
		"phpcompatibility/php-compatibility": "^9.3",
		"phpmd/phpmd": "^2.13",
        "phpstan/phpstan": "^1.1 || ^2.0",
        "phpstan/extension-installer": "^1.1 || ^2.0",
        "saschaegerer/phpstan-typo3": "^1.0 || ^2.0",
        "sat-hub/phpcpd": "^7.0",
		"typo3/testing-framework": "^8.0 || ^9.0",
        "ssch/typo3-rector": "^2.8 | ^3.1"
	},
	"autoload": {
		"psr-4": {
			"DMK\\Mkcleaner\\" : "Classes"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"DMK\\Mkcleaner\\Tests\\" : "Tests"
		}
	},
	"config": {
		"vendor-dir": ".Build/vendor",
		"bin-dir": ".Build/bin",
		"preferred-install": {
			"*": "dist"
		},
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true,
			"phpstan/extension-installer": true
		}
	},
	"extra": {
        "branch-alias" : {
            "dev-13.4": "13.0.x-dev"
        },
		"typo3/cms": {
			"cms-package-dir": "{$vendor-dir}/typo3/cms",
			"extension-key": "mkcleaner",
			"web-dir": ".Build/Web",
			"app-dir": ".Build"
		}
	},
	"scripts": {
        "post-autoload-dump": [
            "[ -e .Build/bin/captainhook ] && .Build/bin/captainhook install -f || echo 'CaptainHook missing, skip install.'"
        ],
		"runqa": [
			"@fix",
			"@lint",
			"@test"
		],
        "lint:php": [
            "[ -e .Build/bin/parallel-lint ] || composer update",
            "echo 'parallel-lint fails with a exception if executed inside the vendor/dmk/mkcleaner folder'",
            "[ ! -e ../../autoload.php ] || mv ../../autoload.php ../../autoload.php.bak",
            ".Build/bin/parallel-lint ./*",
            "[ ! -e ../../autoload.php.bak ] || mv ../../autoload.php.bak ../../autoload.php"
        ],
		"lint": [
			"@lint:php"
		],
		"test:phpcs": [
			"[ -e .Build/bin/php-cs-fixer ] || composer update --ansi",
			".Build/bin/php-cs-fixer fix -v --dry-run --diff  --ansi"
		],
		"test:rector": [
			"[ -e .Build/bin/rector ] || composer update --ansi",
			".Build/bin/rector process --dry-run"
		],
        "test:phpcompatibility": [
            "[ -e .Build/bin/phpcs ] || composer update",
            ".Build/bin/phpcs --ignore=.Build/*,Resources/Private/PHP/* -p . --standard=.Build/vendor/phpcompatibility/php-compatibility/PHPCompatibility --runtime-set testVersion 8.1-8.4"
        ],
		"test:phpmd": [
			"[ -e .Build/bin/phpmd ] || composer update --ansi",
			"php -d error_reporting=\"E_ERROR | E_WARNING | E_PARSE\" .Build/bin/phpmd ./Classes/ text phpmd.xml"
		],
		"test:phpstan": [
			"[ -e .Build/bin/phpstan ] || composer update --ansi",
			".Build/bin/phpstan analyse -c phpstan.neon --memory-limit=512M --ansi"
		],
        "test:phpcpd": [
            "[ -e .Build/bin/phpcpd ] || composer update",
            ".Build/bin/phpcpd Classes"
        ],
		"test:phpunit": [
			"[ -e .Build/bin/phpunit ] || composer update --ansi",
            "export TYPO3_PATH_APP=$PWD/.Build && export TYPO3_PATH_WEB=$PWD/.Build/Web && .Build/bin/phpunit -c .Build/vendor/typo3/testing-framework/Resources/Core/Build/UnitTests.xml Tests/Unit/"
		],
		"test": [
			"@test:phpcs",
			"@test:rector",
			"@test:phpcompatibility",
			"@test:phpmd",
			"@test:phpstan",
            "@test:phpcpd",
			"@test:phpunit"
		],
		"fix:phpcs": [
			"[ -e .Build/bin/php-cs-fixer ] || composer update --ansi",
			".Build/bin/php-cs-fixer fix -v"
		],
		"fix:rector": [
			"[ -e .Build/bin/rector ] || composer update --ansi",
			".Build/bin/rector process"
		],
		"fix": [
			"@fix:rector",
			"@fix:phpcs"
		]
	}
}
